model Order {
  id           String  @id @default(uuid())
  tenantId     String
  number       String
  customerId   String?
  customerName String
  email        String
  phone        String

  // Financial Breakdown
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  shipping Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  refunded Decimal @default(0) @db.Decimal(12, 2)

  // Statuses & Payment
  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentStatus     PaymentStatus     @default(PENDING)
  paymentMethod     PaymentMethod
  couponCode        String?
  channel           OrderChannel      @default(ONLINE)
  codCollected      Boolean           @default(false)
  customerNote      String?           @db.Text

  // Logistics
  shippingMethod String
  courier        String?
  trackingNumber String?

  // Optimistic Concurrency Control
  version Int @default(0)

  // Auditing & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress OrderAddress?
  items           OrderItem[]
  attempts        PaymentAttempt[]
  timeline        OrderTimeline[]
  notes           OrderNote[]
  returns         ReturnRequest[]
    discountRedemptions DiscountRedemption[]


  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("orders")
}

model OrderAddress {
  id       String @id @default(uuid())
  orderId  String @unique
  name     String
  phone    String
  line1    String
  area     String
  district String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  variantId String?
  title     String
  image     String?
  color     String?
  size      String?
  sku       String
  price     Decimal  @db.Decimal(12, 2)
  qty       Int
  createdAt DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model PaymentAttempt {
  id         String        @id @default(uuid())
  orderId    String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus
  gatewayRef String?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_attempts")
}

model OrderTimeline {
  id        String   @id @default(uuid())
  orderId   String
  label     String
  by        String?
  note      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  text      String   @db.Text
  internal  Boolean  @default(true)
  by        String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_notes")
}
