model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  tagline      String?
  domain       String?
  customDomain String?      @unique
  logo         String?
  favicon      String?
  status       TenantStatus @default(ACTIVE)
  plan         TenantPlan   @default(GROWTH)
  planState    String       @default("active") // 'active' | 'trial' | 'past_due' | 'suspended'

  // Multi-Currency & Locale
  currency         String @default("BDT")
  currencySymbol   String @default("৳")
  currencyPosition String @default("prefix") // 'prefix' | 'suffix'

  // Storefront Customization & Theme (JSON format matching TenantTheme)
  theme   Json?
  modules Json?
  contact Json?
  socials Json?

  // Store-wide Settings & Policies
  settings            Json?
  announcement        String?
  announcementEnabled Boolean @default(false)

  // Auditing & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Core Store Relations
  members               TenantMember[]
  roles                 TenantRole[]
  domains               TenantDomain[]
  categories            Category[]
  brands                Brand[]
  collections           Collection[]
  products              Product[]
  orders                Order[]
  returns               ReturnRequest[]
  customers             CustomerProfile[]
  reviews               Review[]
  discounts             Discount[]
  stockMovements        StockMovement[]
  shippingZones         ShippingZone[]
  carts                 Cart[]
  wishlists             WishlistItem[]
  cmsPages              CmsPage[]
  blogPosts             BlogPost[]
  menus                 NavigationMenu[]
  faqs                  FaqItem[]
  mediaAssets           MediaAsset[]
  campaigns             MarketingCampaign[]
  automations           MarketingAutomation[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  apiKeys               ApiKey[]
  webhooks              WebhookEndpoint[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  notifications         Notification[]
  conversations         Conversation[]
  chatMessages          ChatMessage[]
  themes                TenantTheme[]
  searchLogs            SearchQueryLog[]

  @@index([deletedAt])
  @@map("tenants")
}

model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   // e.g. 'Store Manager', 'Fulfillment Staff', 'Customer Care', 'Content Editor'
  description String?
  isSystem    Boolean  @default(false) // System default roles cannot be deleted
  permissions Json     // Granular module permission matrix: { "dashboard": ["view"], "orders": ["view", "create"], ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members TenantMember[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_roles")
}

model TenantMember {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  roleId       String?   // Relation to dynamic TenantRole
  isOwner      Boolean   @default(false) // Direct owner flag with full store access
  status       String    @default("active") // 'active' | 'invited' | 'deactivated'
  twoFactor    Boolean   @default(false)
  lastActiveAt DateTime?

  // Secure Invitation Management
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@map("tenant_members")
}
