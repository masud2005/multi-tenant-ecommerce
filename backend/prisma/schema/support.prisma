model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String?
  orderNumber String?
  subject     String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  from      String // 'customer' | 'agent'
  name      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  actor     String
  action    String
  resource  String
  category  String
  before    String?  @db.Text
  after     String?  @db.Text
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Conversation {
  id               String   @id @default(uuid())
  tenantId         String
  customerId       String?
  customerName     String   @default("Guest Customer")
  customerEmail    String?
  customerPhone    String?
  status           String   @default("active") // 'active' | 'resolved' | 'archived'
  lastMessageAt    DateTime @default(now())
  unreadByOwner    Int      @default(0)
  unreadByCustomer Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  senderId       String?
  senderRole     String   @default("CUSTOMER") // 'CUSTOMER' | 'OWNER' | 'STAFF'
  senderName     String
  encryptedText  String   @db.Text
  iv             String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

