# Application
NODE_ENV=development
PORT=5000

# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=multi_tenant_ecommerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/multi_tenant_ecommerce

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380

# JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Mail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Multi-Tenant E-Commerce <noreply@example.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security & Chat Encryption
CHAT_ENCRYPTION_KEY=9f8b2c4e1a7d5f0e3b6a9c2d4f8a1e5b7c0d3e6f9a2b5c8e1d4f7a0b3c6e9d2f

# Frontend & Owner Seed
FRONTEND_URL=http://localhost:3000
OWNER_NAME="Demo Owner"
OWNER_EMAIL=owner@gmail.com
OWNER_PASSWORD=123456
